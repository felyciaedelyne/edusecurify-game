    "urut = np.argsort(koef)\n",
    "print(\"Mendorong NORMAL :\", [n.split(\"__\", 1)[-1] for n in nama[urut[:15]]])\n",
    "print(\"Mendorong PHISHING:\", [n.split(\"__\", 1)[-1] for n in nama[urut[-15:][::-1]]])"
   ]
