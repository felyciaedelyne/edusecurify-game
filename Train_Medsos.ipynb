    "pred = model.predict(game[\"teks\"])\n",
    "prob = model.predict_proba(game[\"teks\"])[:, 1]\n",
    "print(\"Akurasi:\", accuracy_score(game[\"label\"], pred))\n",
    "print(classification_report(game[\"label\"], pred, target_names=[\"Normal\", \"Phishing\"], zero_division=0))\n",
    "print(\"Confusion matrix [normal, phishing]:\\n\", confusion_matrix(game[\"label\"], pred))\n",
    "game.assign(prob_phishing=prob.round(2), prediksi=pred)[[\"id\", \"label\", \"prediksi\", \"prob_phishing\", \"teks\"]]"
   ]
